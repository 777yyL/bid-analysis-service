# 复制为 .env 后修改。此文件供 Docker Compose 使用。
ANALYZER_API_KEY=replace-with-your-own-analysis-api-key
# 使用字母、数字、下划线或连字符，避免连接串中需要 URL 编码的字符。
ANALYSIS_DB_PASSWORD=replace_with_an_independent_db_password
ANALYSIS_DB_BIND_HOST=10.33.65.152
ANALYSIS_DB_PORT=55434
ANALYZER_BIND_HOST=0.0.0.0
ANALYZER_PORT=8100

# 基础镜像和包源全部来自内网；PostgreSQL tag 需按仓库实际库存确认。
PYTHON_IMAGE=af.hikvision.com.cn/docker/library/python:3.12-slim
ANALYSIS_DB_IMAGE=af.hikvision.com.cn/docker/library/postgres:16-alpine
PIP_INDEX_URL=http://af.hikvision.com.cn/artifactory/api/pypi/pypi/simple
PIP_TRUSTED_HOST=af.hikvision.com.cn

# 宿主机已有正文、附件 MD 的共同根目录，只读挂载到 /source-data。
# 不要填写原 PostgreSQL 的数据目录。
SOURCE_DATA_HOST_PATH=/opt/bid-info-server/data
# 先创建目录，再放入业务域.txt、关键词.txt、产品关键词.txt。
KNOWLEDGE_HOST_PATH=./knowledge
# 如文件仅允许所属组读取，改为宿主机对应的只读文件组 GID。
SOURCE_FILES_GID=10001

# 原系统只读连接。容器访问宿主服务请使用实际内网 IP。
SOURCE_BASE_URL=http://10.33.65.152:8099
SOURCE_DB_DSN=
SOURCE_API_TOKEN=
HTTP_TRUST_ENV=false

# Compose 会固定配置独立分析库、容器内文件路径，无需填写 DATABASE_URL。
INCREMENTAL_ENABLED=false
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_SECONDS=300
COMPENSATION_INTERVAL_SECONDS=21600

# 配置完整后开启；同一空间内所有 API Key 共享平台模型额度。
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true
LLM_RPM=5
# 无命中项目的稳定抽检比例，0 关闭抽检，100 全部抽检。
MODEL_NO_HIT_SAMPLE_PERCENT=5
LLM_TPM=0
LLM_MAX_INPUT_CHARS=28000
LLM_MAX_OUTPUT_TOKENS=3000
