# 复制为 .env 后修改。此文件供 Docker Compose 使用。
ANALYZER_API_KEY=replace-with-your-own-analysis-api-key
# 使用字母、数字、下划线或连字符，避免连接串中需要 URL 编码的字符。
ANALYSIS_DB_PASSWORD=replace_with_an_independent_db_password
ANALYSIS_DB_BIND_HOST=0.0.0.0
ANALYSIS_DB_PORT=55434
ANALYZER_BIND_HOST=0.0.0.0
ANALYZER_PORT=8100

# 基础镜像和包源全部来自内网；PostgreSQL tag 需按仓库实际库存确认。
PYTHON_IMAGE=af.hikvision.com.cn/docker/library/python:3.12-slim
ANALYSIS_DB_IMAGE=af.hikvision.com.cn/docker/library/postgres:16-alpine
PIP_INDEX_URL=http://af.hikvision.com.cn/artifactory/api/pypi/pypi/simple
PIP_TRUSTED_HOST=af.hikvision.com.cn

# 新版数据源、销售项向量模型、复核模型、阶段范围及调度均在系统配置页面设置。
# 以下仅为部署引导参数。加密密钥存放在 analysis-runtime-data 持久卷，备份数据库时一并备份。
SALES_SECRET_KEY_FILE=/app/runtime/settings.key
WORKER_ENABLED=true
# 页面配置主服务器文件分享地址及密钥；材料下载到 /app/runtime/materials 持久卷。
# 主服务器单独部署 compose.files.yaml，环境变量示例见 .env.files.example。
# 使用主服务同一数据库存储结果时，必须配置独立 schema（如 sales_match）。
# 默认继续使用独立 bid_analysis 库，无需修改。
ANALYSIS_SCHEMA=
