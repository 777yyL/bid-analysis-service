# Copy to .env.shared. Do not commit filled credentials.
SOURCE_MODE=shared
DATABASE_URL=postgresql+psycopg://analysis_user:REPLACE_PASSWORD@MAIN_DATABASE_HOST:5432/MAIN_DATABASE
ANALYSIS_SCHEMA=bid_analysis
ANALYZER_API_KEY=REPLACE_WITH_RANDOM_KEY
ANALYSIS_RUNTIME_DIR=/opt/bid-analysis/runtime
BID_DATA_DIR=/opt/bid-info-server/data
SOURCE_FILE_ROOT=/data/bidinfo
SALES_SECRET_KEY_FILE=/app/runtime/settings.key
ANALYZER_BIND_HOST=127.0.0.1
ANALYZER_PORT=8100
WORKER_ENABLED=true
# Optional agent-only token. Empty disables MCP; never reuse ANALYZER_API_KEY.
MCP_API_KEY=
