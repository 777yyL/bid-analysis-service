# 新服务接口密钥；部署前替换。Swagger 的 Authorize 使用此值。
ANALYZER_API_KEY=replace-with-your-own-analysis-api-key

# Compose 自带的独立结果库，禁止填写原 bidinfo 数据库地址。
# 此密码直接用于 Compose 连接串，请使用字母、数字、下划线或连字符。
ANALYSIS_DB_PASSWORD=replace_with_an_independent_db_password
# 需要从其他电脑访问时改为部署机对应地址或 0.0.0.0。
ANALYZER_BIND_HOST=127.0.0.1
ANALYZER_PORT=8100

# 原平台只读 HTTP 通道。
SOURCE_BASE_URL=http://10.33.65.152:8099
SOURCE_API_TOKEN=
SOURCE_AUTH_HEADER=Authorization
SOURCE_TIMEOUT_SECONDS=30
SOURCE_MAX_RESPONSE_BYTES=20000000
SOURCE_NOTICES_PATH=/api/v1/admin/notices
SOURCE_NOTICE_PATH=/api/v1/admin/notices/{notice_id}
SOURCE_ATTACHMENT_PATH=/api/v1/admin/attachments/{att_id}/text
SOURCE_KEYWORDS_PATH=/api/v1/kb/keywords
SOURCE_PAGE_PARAM=page
SOURCE_PAGE_SIZE_PARAM=page_size

# 正文未按常见字段返回时可指定字段路径，示例 data.notice.body_html。
SOURCE_BODY_FIELD=

# 内网默认直连；确需继承系统/环境代理时设 true，并配置 NO_PROXY 排除内网地址。
HTTP_TRUST_ENV=false

# 可选：原库只读账号，用于读取完整业务知识及相同 SHA 附件兜底。
# 使用 psycopg DSN，特殊字符需 URL 编码。连接强制只读，原库不会建表。
# 不配置时可用 /knowledge/import 导入完整 JSON。
# 仅靠关键词 HTTP 同步需要接口返回业务域，且结果会标记待复核。
SOURCE_DB_DSN=

# 默认不调用模型。先验证 prepare，再设置 LLM_ENABLED=true 并重建服务。
# URL 填到 /v1 层；客户端追加 /chat/completions。
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=120
LLM_RPM=5

# 0 表示不额外限制 TPM；开启时按 UTF-8 字节数加输出预算保守预留。
LLM_TPM=0
LLM_MAX_OUTPUT_TOKENS=3000
LLM_MAX_INPUT_CHARS=28000

# 检索分不等于业务分。候选或证据覆盖不足会进入 needs_review。
CANDIDATE_LIMIT=8
EVIDENCE_MAX_CHARS=12000
EVIDENCE_CHUNK_CHARS=700
KNOWLEDGE_MAX_CHARS_PER_LINE=1800
MATERIAL_MAX_CHARS=2000000
JOB_MAX_ATTEMPTS=3
JOB_RETRY_SECONDS=30
WORKER_POLL_SECONDS=1
WORKER_ENABLED=true
